---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const originalShots = [
  { src: `${base}images/sizeshift-unity-01.webp`, alt: 'Original SizeShift Adventure Unity gameplay showing the size-shift gun and a pressure-button puzzle.' },
  { src: `${base}images/sizeshift-unity-02.webp`, alt: 'Original SizeShift Adventure tutorial demonstrating boxes at different sizes.' },
  { src: `${base}images/sizeshift-unity-03.webp`, alt: 'Original SizeShift Adventure laser-trap puzzle with a movable box.' },
  { src: `${base}images/sizeshift-unity-04.webp`, alt: 'Original SizeShift Adventure level exit and puzzle environment.' },
];
const letterShots = [
  { src: `${base}images/letter-quest-01.webp`, alt: 'Letter Quest first-person level with a collectible letter K.' },
  { src: `${base}images/letter-quest-02.webp`, alt: 'Letter Quest inventory screen for collecting letters.' },
  { src: `${base}images/letter-quest-03.webp`, alt: 'Letter Quest word puzzle showing a missing letter in APPLE.' },
  { src: `${base}images/letter-quest-04.webp`, alt: 'Letter Quest word-completion and object-generation puzzle.' },
];
const remakeShots = [
  { src: `${base}images/sizeshift-ue5-01.png`, alt: 'UE5 remake tutorial area showing movement, jump, and crouch controls.', caption: 'Tutorial area · movement and crouch controls' },
  { src: `${base}images/sizeshift-ue5-02.png`, alt: 'UE5 remake level with a ladder attached to a tall wall.', caption: 'Traversal · ladder route' },
  { src: `${base}images/sizeshift-ue5-03.png`, alt: 'UE5 remake looking up through a narrow passage with physics boxes.', caption: 'Physics puzzle · stacked boxes' },
  { src: `${base}images/sizeshift-ue5-04.png`, alt: 'UE5 remake size-shift box highlighted with interact, size up, and size down controls.', caption: 'Size-shift interaction · resize controls' },
  { src: `${base}images/sizeshift-ue5-05.png`, alt: 'UE5 remake glowing movable box with grab and release instructions.', caption: 'Object handling · grab and release' },
];
---
<BaseLayout title="Ang Shi Xuan — Game Programmer" description="Ang Shi Xuan is a game programmer building playful gameplay systems in Unreal Engine 5, Unity, C++, and C#.">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="topbar wrap">
    <a class="brand" href="#top" aria-label="Ang Shi Xuan, home"><span class="brand-icon" aria-hidden="true">ASX</span><span>ANG SHI XUAN<span class="brand-dot">.</span></span></a>
    <nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#experience">Experience</a><a href="#about">About</a></nav>
    <a class="contact-pill" href="mailto:asxuan0813@gmail.com">Say hello <span aria-hidden="true">↗</span></a>
  </header>

  <main id="main">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> GAME PROGRAMMER · CHERAS, MALAYSIA</p>
        <h1 id="hero-title">Making<br />play <span>make sense.</span></h1>
        <p class="intro">I’m <strong>Ang Shi Xuan</strong>, a Computer Science graduate focused on gameplay programming, physics-based interactions, and interactive systems.</p>
        <div class="hero-actions"><a class="button primary" href="#projects">See selected work <span aria-hidden="true">↓</span></a><a class="button quiet" href="https://drive.google.com/file/d/1Wqsd8ejFTHMDVPAzLf81oN3h0p4Ex5A1/view?usp=sharing" target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a></div>
        <div class="hero-stack"><span>NOW BUILDING</span><b>SizeShift Adventure <i>UE5 / C++</i></b></div>
      </div>
      <div class="hero-art" aria-label="Decorative arcade-inspired geometric level scene">
        <div class="art-stamp">PLAYER<br />ONE <span>▶</span></div>
        <div class="art-sun"></div><div class="art-star star-one">✳</div><div class="art-star star-two">✦</div>
        <div class="art-platform p-one"><span>01</span></div><div class="art-platform p-two"><span>02</span></div><div class="art-platform p-three"><span>03</span></div>
        <div class="art-avatar"><i></i><b></b></div><div class="art-ball"></div><div class="art-coins"><i>✦</i><i>✦</i><i>✦</i></div>
        <div class="art-hud"><span>LEVEL 01</span><span>✦ ✦ ✦</span></div>
        <div class="art-bottom"><span>PRESS START</span><span>▲ ▼ ◀ ▶</span></div>
      </div>
      <div class="hero-caption"><span>✳</span> SYSTEMS THINKING, WITH A PLAYFUL EDGE.</div>
    </section>

    <section class="section projects" id="projects" aria-labelledby="projects-title"><div class="wrap">
      <div class="section-head"><div><p class="eyebrow">01 / Select your level</p><h2 id="projects-title">Projects</h2></div><p>Gameplay systems, physics puzzles, and small details that help a player understand what to do next.</p></div>

      <article class="feature-project" aria-labelledby="ue-title">
        <div class="feature-top"><span class="project-index">01</span><span class="project-status"><i></i> CURRENT BUILD</span><span class="project-engine">UNREAL ENGINE 5 / C++</span></div>
        <div class="feature-content"><div class="feature-copy"><p class="eyebrow">Featured · Gameplay programming</p><h3 id="ue-title">SizeShift<br /><em>Adventure</em></h3><p class="feature-lede">A first-person physics puzzle game where resizing boxes changes how you move through a level and solve space-based problems.</p>
          <div class="tech-row"><span>UE5</span><span>C++</span><span>Blueprint</span><span>Physics</span></div>
          <a class="text-link" href="https://app.notion.com/p/3fa2d26453cc81c7b2cecfe52e2d44b4" target="_blank" rel="noreferrer">Read the technical case study <b aria-hidden="true">↗</b></a>
        </div>
        <div class="feature-visual" aria-label="Illustration of the SizeShift box-size gameplay mechanic"><div class="visual-grid"></div><span class="visual-note note-a">SCALE / 0.5×</span><span class="visual-note note-b">RESIZE → RE-THINK</span><div class="box box-small"><i>0.5×</i></div><div class="box box-medium"><i>1.0×</i></div><div class="box box-large"><i>2.0×</i></div><div class="resize-arrow">↗</div><div class="visual-floor"></div></div></div>
        <div class="remake-gallery" aria-label="SizeShift Adventure Remake Unreal Engine 5 screenshots"><h4>REMAKE IN PROGRESS <span>UE5 GAMEPLAY CAPTURES</span></h4><div class="remake-gallery-grid">{remakeShots.map((shot, i) => <figure><a href={shot.src} target="_blank" rel="noreferrer" aria-label={`Open SizeShift UE5 screenshot ${i + 1}`}><img src={shot.src} alt={shot.alt} loading="lazy" /></a><figcaption>{shot.caption}</figcaption></figure>)}</div></div>
        <div class="remake-video"><div class="remake-video-head"><span>GAMEPLAY VIDEO · UE5 REMAKE</span><a href="https://drive.google.com/file/d/1I3Di2hoLy5IF_poJMix0dqgSpYPId5w_/view?usp=sharing" target="_blank" rel="noreferrer">Open video ↗</a></div><div class="video-frame"><iframe src="https://drive.google.com/file/d/1I3Di2hoLy5IF_poJMix0dqgSpYPId5w_/preview" title="SizeShift Adventure Remake Unreal Engine 5 gameplay video" loading="lazy" allow="autoplay" allowfullscreen></iframe></div></div>        <div class="feature-bottom"><span>ONE PLAYABLE LEVEL · IN DEVELOPMENT</span><span>CHARACTER → GUN → BOX</span></div>
      </article>

      <div class="featured-facts"><div><b>THE SYSTEM</b><p>Character input, interaction flow, and box-specific rules live in separate systems.</p></div><div><b>THE FEEL</b><p>Small, medium, and large boxes shift between pickup, push/pull, and immovable behaviour.</p></div><div><b>THE DETAILS</b><p>Collision-aware growth updates visual scale, volume, density-based mass, and interaction type.</p></div></div>

      <div class="project-grid">
        <article class="project-card" aria-labelledby="original-title">
          <div class="card-head"><span class="project-index">02</span><span>UNITY · C#</span></div>
          <h3 id="original-title">SizeShift Adventure <small>Original Unity version</small></h3>
          <p>A solo-developed final-year project and the starting point for the UE5 remake. Use a Size-Shift Gun to resize sponge, wood, and metal boxes, trigger pressure buttons, block lasers, and solve progressively harder puzzles.</p>
          <div class="contribution"><b>MY CONTRIBUTION</b><span>Sole Programmer · Game designer · Level designer</span></div>
          <div class="gallery" aria-label="SizeShift Adventure original Unity screenshots">{originalShots.map((shot, i) => <a href={shot.src} target="_blank" rel="noreferrer" aria-label={`Open SizeShift Unity screenshot ${i + 1}`}><img src={shot.src} alt={shot.alt} loading="lazy" /></a>)}</div>
          <div class="card-links"><a href="https://app.notion.com/p/2902d26453cc802ba60ae332ff890f20" target="_blank" rel="noreferrer">Project notes ↗</a><a href="https://drive.google.com/file/d/1Fu8WMPN0xCnysCxlkyOFF_PbDsKeX-99/preview" target="_blank" rel="noreferrer">Open gameplay video ↗</a></div>
          <div class="video-frame"><iframe src="https://drive.google.com/file/d/1Fu8WMPN0xCnysCxlkyOFF_PbDsKeX-99/preview" title="SizeShift Adventure original Unity gameplay video" loading="lazy" allow="autoplay" allowfullscreen></iframe></div>
        </article>

        <article class="project-card letter-card" aria-labelledby="letter-title">
          <div class="card-head"><span class="project-index">03</span><span>UNITY · C#</span></div>
          <h3 id="letter-title">Letter Quest</h3>
          <p>A solo-developed educational first-person puzzle game. Explore, collect letters, complete missing words, and unlock object-generation abilities that turn vocabulary into a gameplay loop.</p>
          <div class="contribution"><b>MY CONTRIBUTION</b><span>Lead programmer · Game designer</span></div>
          <div class="gallery" aria-label="Letter Quest gameplay screenshots">{letterShots.map((shot, i) => <a href={shot.src} target="_blank" rel="noreferrer" aria-label={`Open Letter Quest screenshot ${i + 1}`}><img src={shot.src} alt={shot.alt} loading="lazy" /></a>)}</div>
          <div class="card-links"><a href="https://app.notion.com/p/2902d26453cc800f91e2ee1b2bc4530d" target="_blank" rel="noreferrer">Project notes ↗</a><a href="https://drive.google.com/file/d/1-lnmOnG6171QQ_tvjegbNq1gTRaQKko7/preview" target="_blank" rel="noreferrer">Open gameplay video ↗</a></div>
          <div class="video-frame"><iframe src="https://drive.google.com/file/d/1-lnmOnG6171QQ_tvjegbNq1gTRaQKko7/preview" title="Letter Quest gameplay video" loading="lazy" allow="autoplay" allowfullscreen></iframe></div>
        </article>
      </div>
      <p class="asset-note">The Unity galleries show the original projects. The captures above show the in-progress UE5 remake; its scope and system design are described in the case study.</p>
    </div></section>

    <section class="section experience" id="experience" aria-labelledby="experience-title"><div class="wrap experience-wrap">
      <div class="section-head"><div><p class="eyebrow">02 / Continue the run</p><h2 id="experience-title">Experience</h2></div><p>Production experience inside an existing game project, working across gameplay, UI, debugging, and polish.</p></div>
      <article class="experience-card"><div class="exp-marker">★</div><div><div class="exp-meta"><span>ALVA PRODUCTIONS</span><span>GAME DEVELOPER INTERN</span></div><h3>Gameplay systems in a story-driven 3D game.</h3><p>Contributed to an existing Unity/C# project across interaction and inventory, UI and mini-games, camera and NPC behaviour, scene polish, and production fixes. Completed the internship with distinction.</p><ul><li>Extended inventory and item progression with ScriptableObject-driven descriptions, pickups, inspection, and item carry.</li><li>Implemented mini-game, quest, dialogue, photo-capture, and inspection flows.</li><li>Investigated teleport, camera, lighting, collision, and asset issues; improved teleport reliability by handling the CharacterController during execution.</li></ul><div class="private-note"><span aria-hidden="true">▣</span> Company project media and source are intentionally not shown.</div></div><a class="exp-link" href="https://app.notion.com/p/3df2d26453cc81d59496c26a538f60d5" target="_blank" rel="noreferrer">Details ↗</a></article>
    </div></section>

    <section class="section about" id="about" aria-labelledby="about-title"><div class="wrap about-grid"><div><p class="eyebrow">03 / About the player</p><h2 id="about-title">Curious about<br /><span>how games work.</span></h2></div><div class="about-copy"><p class="about-lead">I like the moment a system clicks: the player understands it, the rules hold together, and the interaction feels satisfying.</p><p>With a Computer Science background in Game Development, I work across Unreal Engine 5 and Unity. I’m interested in gameplay programming, physics, AI/pathfinding, and interactive systems—and keen to grow with a thoughtful game team.</p><div class="skill-groups"><div><b>LANGUAGES</b><span>C++ · C#</span></div><div><b>ENGINES</b><span>Unreal Engine 5 · Blueprint · Unity</span></div><div><b>GAMEPLAY</b><span>Physics · AI / pathfinding · Interactive systems</span></div><div><b>TOOLS</b><span>Git · Visual Studio · Blender</span></div></div></div></div></section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="wrap contact-inner"><div><p class="eyebrow">04 / Next level</p><h2 id="contact-title">Have a good<br /><em>challenge?</em></h2><p>Open to Junior Game Programmer opportunities and conversations about gameplay systems.</p></div><div class="contact-actions"><a class="button primary" href="mailto:asxuan0813@gmail.com">asxuan0813@gmail.com <span aria-hidden="true">↗</span></a><a class="button light" href="https://github.com/asxuan0813" target="_blank" rel="noreferrer">GitHub profile <span aria-hidden="true">↗</span></a><a class="button light" href="https://drive.google.com/file/d/1Wqsd8ejFTHMDVPAzLf81oN3h0p4Ex5A1/view?usp=sharing" target="_blank" rel="noreferrer">Download resume <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <footer class="footer wrap"><a class="brand" href="#top"><span class="brand-icon" aria-hidden="true">ASX</span><span>ANG SHI XUAN<span class="brand-dot">.</span></span></a><span>Built with curiosity and a lot of playtesting.</span><a href="#top">Back to top ↑</a></footer>
</BaseLayout>

<style>
